# Copy to `.env` and fill in. `.env` is gitignored and never committed.
# install.sh reads these to render config/opencode.json.tmpl.
# Leave blank to be prompted interactively (non-interactive installs get a placeholder).

OPENROUTER_API_KEY=

# Set to 1 to skip the automatic karakuri (rules + skills) bootstrap.
# SKIP_KARAKURI=0