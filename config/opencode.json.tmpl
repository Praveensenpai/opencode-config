{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "model": "or/particle-1-free",
  "plugin": ["./plugins/karakuri/plugin.js"],
  "plugins": [
    {
      "package": "./interval-ping",
      "options": { "message": "◷ ping", "intervalMinutes": 5 }
    },
    {
      "package": "./background-tasks",
      "options": { "width": 40 }
    },
    {
      "package": "./quota-fallback",
      "options": {
        "providers": ["or"],
        "fallbackModels": [
          "or/particle-1-free",
          "or/nemotron-3.5-lightning-free",
          "or/nemotron-3.5-super-vl-free",
          "or/ling-3.2-flash-free",
          "or/inkling-2-small-free",
          "or/nemotron-3-ultra-free",
          "or/ernie-5.5-flash-preview-free",
          "or/nemotron-3-nano-omni-free",
          "or/gemma-4-31b-free",
          "or/gemma-4-26b-a4b-free",
          "or/north-mini-code-free",
          "or/flint-free",
          "or/dots3-note-preview-free",
          "or/lfm3-1.7b-free"
        ],
        "strategy": "round-robin",
        "includeRateLimit": false,
        "rateLimitAttempts": 3,
        "blacklistMinutes": 30,
        "maxWaitMs": 900000,
        "delayMs": 500
      }
    }
  ],
  "compaction": {
    "auto": true,
    "reserved": 64000
  },
  "providers": {
    "or": {
      "name": "OpenRouter (free)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "__OPENROUTER_API_KEY__"
      },
      "models": {
        "particle-1-free": {
          "modelID": "particle-ai/particle-1:free",
          "name": "Particle-1 (free)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 131072 },
          "cost": [ { "input": 0, "output": 0, "cache": { "read": 0, "write": 0 } } ]
        },
        "nemotron-3.5-lightning-free": {
          "modelID": "nvidia/nemotron-3.5-lightning:free",
          "name": "Nemotron 3.5 Lightning (free)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 262144 },
